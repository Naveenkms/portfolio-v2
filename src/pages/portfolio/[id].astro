---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/sections/Header.astro";
import Footer from "../../components/sections/Footer.astro";
import { getCollection, render } from "astro:content";
import Button from "../../components/ui/button/Button.astro";
import GlowLineSeparator from "../../components/ui/separator/GlowLineSeparator.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Split tech stack string into tags
const tags = project.data.techStack.split(/[•,]/).map((t) => t.trim());
---

<html lang="en" data-theme="dark" class="dark">
  <head>
    <BaseHead
      title={project.data.title}
      description={project.data.description}
    />
  </head>
  <body class="bg-[var(--background)] text-foreground">
    <Header />

    <main class="use-utility-layout">
      <section
        class="w-full pt-12 md:pt-20 overflow-hidden relative"
      >
        <div class="mx-auto max-w-5xl px-4 relative z-10 text-center">
          <div class="mb-10">
            <a
              href="/#portfolio"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[var(--surface-100)] border border-[var(--border)] text-[var(--accent)] hover:bg-[var(--surface-200)] transition-all duration-300 no-underline font-medium text-sm group"
            >
              <svg
                class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-[-4px]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"></path>
              </svg>
              Back to Projects
            </a>
          </div>

          <h1
            class="text-5xl md:text-7xl font-extrabold tracking-tight leading-tight mb-8"
          >
            <span
              class="bg-gradient-to-r from-[var(--accent)] to-[var(--secondary)] bg-clip-text text-transparent"
            >
              {project.data.title}
            </span>
          </h1>
          <!-- Project Visual -->
          <div class="relative group max-w-5xl mx-auto mb-8">
            <div
              class="absolute -inset-4 bg-gradient-to-r from-[var(--accent)]/40 to-[var(--secondary)]/40 blur-3xl opacity-20 group-hover:opacity-40 transition-opacity duration-700 rounded-3xl"
            >
            </div>
            <div
              class="relative overflow-hidden rounded-2xl border border-[var(--border)] shadow-2xl bg-[var(--card)]"
            >
              <img
                src={project.data.image}
                alt={project.data.title}
                class="w-full h-auto object-cover transition-transform duration-1000 group-hover:scale-[1.02]"
              />
            </div>
          </div>
          <div class="flex flex-wrap justify-center gap-3 mb-10">
            {
              tags.map((tag) => (
                <span class="px-4 py-1.5 rounded-full text-sm font-semibold border border-[var(--accent)]/30 bg-[var(--accent)]/5 text-[var(--accent)] backdrop-blur-sm">
                  {tag}
                </span>
              ))
            }
          </div>

          <p
            class="text-xl md:text-2xl text-[var(--color-text-secondary)] leading-relaxed max-w-3xl mx-auto mb-12"
          >
            {project.data.description}
          </p>

          {
            project.data.cta && project.data.cta.length > 0 && (
              <div class="flex flex-wrap justify-center gap-4 mb-20">
                {project.data.cta.map((link, index) => (
                  <Button
                    href={link.link}
                    variant={index === 0 ? "primary" : "outline"}
                    size="lg"
                    target="_blank"
                  >
                    {link.text}
                  </Button>
                ))}
              </div>
            )
          }
        </div>
        <div class="mx-auto max-w-3xl px-4">
          <div
            class="prose prose-invert prose-lg max-w-none
              prose-headings:text-foreground prose-headings:font-bold
              prose-h2:text-4xl prose-h2:mb-8 prose-h2:mt-16
              prose-h3:text-2xl prose-h3:mb-6 prose-h3:mt-10
              prose-p:text-[var(--color-text-secondary)] prose-p:leading-relaxed prose-p:mb-6
              prose-li:text-[var(--color-text-secondary)] prose-li:mb-2
              prose-strong:text-[var(--accent)]
              prose-a:text-[var(--accent)] prose-a:no-underline hover:prose-a:underline
              prose-img:rounded-3xl prose-img:border prose-img:border-[var(--border)] prose-img:shadow-2xl"
          >
            <Content />
          </div>
        </div>
      </section>

      

     
        
      

      <div class="mx-auto max-w-5xl px-4 py-8">
        <GlowLineSeparator />
      </div>

      
    </main>

    <Footer />
  </body>
</html>

<style>
  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 10px;
  }
  ::-webkit-scrollbar-track {
    background: var(--background);
  }
  ::-webkit-scrollbar-thumb {
    background: var(--surface-300);
    border-radius: 5px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--accent);
  }
</style>
