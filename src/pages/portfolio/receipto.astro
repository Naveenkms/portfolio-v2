---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/sections/Header.astro";
import Footer from "../../components/sections/Footer.astro";
import { Content as ReceiptoContent } from "../../content/projects/receipto.md";

const title = "Receipto";
const description = "Receipto Project Description";
---

<html lang="en" data-theme="dark" class="dark">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <main>
      <section class="w-full mx-auto max-w-5xl md:px-4 py-6 md:py-10 [&>h2]:mt-4">
        <ReceiptoContent />
      </section>
    </main>
    <Footer />
  </body>
</html>
